{
  "display_information": {
    "name": "Foundry Front Desk",
    "description": "Phone messages taken by the club's AI receptionist",
    "background_color": "#141414"
  },
  "features": {
    "bot_user": {
      "display_name": "Foundry Front Desk",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["incoming-webhook", "chat:write"]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
